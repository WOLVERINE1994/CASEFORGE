{
  "name": "ai-qa-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "agent": "node scripts/caseforge-agent.mjs",
    "agent:desktop": "npm --prefix desktop-agent run dev",
    "agent:desktop:dist": "npm --prefix desktop-agent run dist:win",
    "adapter:legacy-local-agent": "node scripts/caseforge-agent.mjs",
    "adapter:legacy-desktop": "npm --prefix desktop-agent run dev",
    "adapter:legacy-desktop:dist": "npm --prefix desktop-agent run dist:win",
    "worker:playwright": "node workers/playwright-worker/index.mjs",
    "worker:browser-sessions": "node workers/browser-session-service/server.mjs",
    "worker:automation-execution": "node workers/automation-execution-service/server.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint . --max-warnings=0",
    "test:automation": "node --test tests/automation/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run lint:strict && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "exceljs": "^3.4.0",
    "groq-sdk": "^1.1.1",
    "next": "^16.2.6",
    "openai": "^6.27.0",
    "playwright": "^1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
