generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  tester
  reviewer
  manager
}

enum ProjectStatus {
  active
  archived
}

enum SprintStatus {
  planned
  active
  completed
}

enum IssueType {
  epic
  story
  task
  bug
  test_case
  test_plan
  test_run
}

enum IssueStatus {
  backlog
  todo
  in_progress
  blocked
  in_review
  done
}

enum Priority {
  highest
  high
  medium
  low
}

enum SourceType {
  manual
  jira
  prd
  api_spec
  user_story
  changelog
}

enum GenerationMode {
  functional
  negative
  edge
  ui
  api
  regression
}

enum CoverageDepth {
  basic
  standard
  thorough
}

enum Persona {
  all
  admin
  guest
  first_time_user
  returning_user
  blocked_user
}

enum SignoffStatus {
  draft
  in_review
  approved
  changes_requested
}

enum TestCaseType {
  functional
  regression
  api
  ui
  negative
  edge
}

enum TestCaseStatus {
  draft
  ready
  review
  approved
  obsolete
}

enum AutomationScenarioStatus {
  draft
  active
  paused
  completed
  archived
}

enum AutomationRunStatus {
  queued
  running
  passed
  failed
  blocked
  canceled
}

enum AutomationSessionStatus {
  creating
  idle
  running
  broken
  terminating
  terminated
  requested
  starting
  ready
  recording
  closed
  failed
}

enum AutomationSessionProvider {
  managed_browser
  self_hosted_playwright
  optional_local_connector
}

enum AutomationArtifactType {
  trace
  video
  log
  network
  screenshot
  auth_state
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  avatarUrl           String?
  role                UserRole
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  ownedProjects       Project[]     @relation("ProjectOwner")
  ledProjects         Project[]     @relation("ProjectLead")
  teamMemberships     TeamMember[]
  createdRequirements Requirement[] @relation("RequirementCreator")
  testCases           TestCase[]    @relation("TestCaseOwner")
  reportedIssues      Issue[]       @relation("IssueReporter")
  assignedIssues      Issue[]       @relation("IssueAssignee")
  comments            Comment[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  key       String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id              String          @id @default(cuid())
  key             String?         @unique
  name            String
  description     String?
  status          ProjectStatus   @default(active)
  input           String          @default("")
  generationMode  GenerationMode  @default(functional)
  coverageDepth   CoverageDepth   @default(standard)
  persona         Persona         @default(all)
  autosaveEnabled Boolean         @default(true)
  reviewerName    String          @default("")
  reviewerNotes   String          @default("")
  signoffStatus   SignoffStatus   @default(draft)
  rows            Json            @default("[]")
  sourceArtifacts Json            @default("[]")
  auditTrail      Json            @default("[]")
  ownerId         String?
  teamId          String?
  leadUserId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner           User?           @relation("ProjectOwner", fields: [ownerId], references: [id])
  team            Team?           @relation(fields: [teamId], references: [id])
  lead            User?           @relation("ProjectLead", fields: [leadUserId], references: [id])
  changeComparisons ChangeComparison[]
  requirements    Requirement[]
  testCases       TestCase[]
  sprints         Sprint[]
  issues          Issue[]
  automationScenarios AutomationScenario[]
  automationSuites AutomationSuite[]
  automationActions AutomationAction[]
  automationRuns AutomationRun[]
  automationEnvironments AutomationEnvironment[]
  automationSessions AutomationSession[]
  automationViews AutomationView[]
  automationElements AutomationElement[]
  automationElementUsages AutomationElementUsage[]
  automationPlaybackJobs AutomationPlaybackJob[]
  automationPlaybackConfigs AutomationPlaybackConfig[]
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(planned)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
}

model Issue {
  id            String      @id @default(cuid())
  projectId      String
  issueNumber    Int
  issueKey       String      @unique
  type           IssueType
  summary        String
  description    String?
  status         IssueStatus @default(backlog)
  priority       Priority    @default(medium)
  reporterId     String?
  assigneeId     String?
  sprintId       String?
  parentIssueId  String?
  dueDate        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter       User?       @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee       User?       @relation("IssueAssignee", fields: [assigneeId], references: [id])
  sprint         Sprint?     @relation(fields: [sprintId], references: [id])
  parentIssue    Issue?      @relation("IssueHierarchy", fields: [parentIssueId], references: [id])
  childIssues    Issue[]     @relation("IssueHierarchy")
  labels         IssueLabel[]
  comments       Comment[]
  testCase       TestCase?

  @@unique([projectId, issueNumber])
}

model IssueLabel {
  id        String   @id @default(cuid())
  issueId   String
  label     String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
}

model AccessRequest {
  id                 String              @id @default(cuid())
  email              String              @unique
  clerkUserId        String?
  status             AccessRequestStatus @default(pending)
  requestCount       Int                 @default(1)
  firstRequestedAt   DateTime            @default(now())
  lastRequestedAt    DateTime            @default(now())
  lastPath           String              @default("")
  decisionTokenHash  String              @unique
  notificationSentAt DateTime?
  decidedAt          DateTime?
  decidedByEmail     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, lastRequestedAt])
  @@index([email])
}

model ChangeComparison {
  id                       String   @id @default(cuid())
  projectId                String
  oldRequirement           String
  newRequirement           String
  signature                String?
  changes                  Json     @default("[]")
  generatedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Requirement {
  id                String      @id @default(cuid())
  projectId         String
  title             String
  sourceType        SourceType  @default(manual)
  sourceRef         String?
  rawContent        String
  normalizedContent String
  version           Int         @default(1)
  isActive          Boolean     @default(true)
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User?       @relation("RequirementCreator", fields: [createdById], references: [id])
  testCases         TestCase[]
}

model TestCase {
  id             String         @id @default(cuid())
  projectId      String
  issueId        String?        @unique
  requirementId  String?
  caseKey        String         @unique
  title          String
  type           TestCaseType
  preconditions  String
  steps          String
  expectedResult String
  testData       String?
  priority       String?
  status         TestCaseStatus @default(draft)
  ownerId        String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue          Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)
  requirement    Requirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  owner          User?          @relation("TestCaseOwner", fields: [ownerId], references: [id])
}

model AutomationScenario {
  id          String                   @id @default(cuid())
  projectId   String
  version     Int                      @default(1)
  name        String
  description String                   @default("")
  status      AutomationScenarioStatus @default(draft)
  tags        Json                     @default("[]")
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps       AutomationStep[]
  runs        AutomationRun[]
  sessions    AutomationSession[]
  suiteMemberships AutomationSuiteScenario[]

  @@index([projectId, updatedAt])
}

model AutomationSuite {
  id          String                   @id @default(cuid())
  projectId   String
  version     Int                      @default(1)
  name        String
  description String                   @default("")
  status      AutomationScenarioStatus @default(draft)
  tags        Json                     @default("[]")
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios   AutomationSuiteScenario[]

  @@index([projectId, updatedAt])
}

model AutomationSuiteScenario {
  id         String             @id @default(cuid())
  projectId  String
  suiteId    String
  scenarioId String
  addedAt    DateTime           @default(now())

  suite      AutomationSuite     @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  scenario   AutomationScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([suiteId, scenarioId])
  @@index([projectId, suiteId])
  @@index([projectId, scenarioId])
}

model AutomationAction {
  id                    String           @id @default(cuid())
  projectId             String
  version               Int              @default(1)
  createdFromScenarioId String?
  name                  String
  description           String           @default("")
  tags                  Json             @default("[]")
  metadata              Json             @default("{}")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps                 AutomationStep[]

  @@index([projectId, updatedAt])
}

model AutomationStep {
  id                  String                @id @default(cuid())
  projectId           String
  version             Int                   @default(1)
  scenarioId          String?
  actionId            String?
  orderIndex          Int
  action              String
  description         String
  target              Json                  @default("{}")
  inputValue          String                @default("")
  expectedValue       String                @default("")
  assertionType       String                @default("")
  options             Json                  @default("{}")
  commandText         String                @default("")
  elementSnapshot     Json                  @default("{}")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  scenario            AutomationScenario?   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  actionRecord        AutomationAction?     @relation(fields: [actionId], references: [id], onDelete: Cascade)
  locatorCandidates   AutomationLocatorCandidate[]

  @@index([projectId, scenarioId, orderIndex])
  @@index([projectId, actionId, orderIndex])
}

model AutomationLocatorCandidate {
  id              String         @id @default(cuid())
  version         Int            @default(1)
  stepId          String
  strategy        String
  value           String
  score           Int
  isUnique        Boolean        @default(false)
  rank            Int
  source          String         @default("recorded")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  step            AutomationStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, rank])
}

model AutomationEnvironment {
  id                String      @id @default(cuid())
  projectId         String
  version           Int         @default(1)
  name              String
  businessName      String   @default("")
  technicalName     String   @default("")
  aliases           Json     @default("[]")
  description       String   @default("")
  baseUrl           String      @default("")
  variables         Json        @default("{}")
  authStateArtifactId String?
  isDefault         Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs              AutomationRun[]
  sessions          AutomationSession[]

  @@index([projectId, isDefault])
}

model AutomationSession {
  id                  String                    @id @default(cuid())
  projectId           String
  version             Int                       @default(1)
  scenarioId          String?
  environmentId       String?
  provider            AutomationSessionProvider
  providerSessionId   String?
  status              AutomationSessionStatus   @default(requested)
  liveViewUrl         String?
  expiresAt           DateTime?
  capabilities        Json                      @default("{}")
  metadata            Json                      @default("{}")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario            AutomationScenario?        @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  environment         AutomationEnvironment?     @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  runs                AutomationRun[]

  @@index([projectId, status, updatedAt])
}

model AutomationRun {
  id              String              @id @default(cuid())
  projectId       String
  version         Int                 @default(1)
  scenarioId      String?
  sessionId       String?
  environmentId   String?
  status          AutomationRunStatus @default(queued)
  startedAt       DateTime?
  finishedAt      DateTime?
  summary         Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario        AutomationScenario?  @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  session         AutomationSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  environment     AutomationEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  artifacts       AutomationArtifact[]

  @@index([projectId, createdAt])
  @@index([scenarioId, createdAt])
}

model AutomationArtifact {
  id          String                 @id @default(cuid())
  projectId   String
  version     Int                    @default(1)
  runId       String?
  type        AutomationArtifactType
  label       String
  uri         String
  mimeType    String?
  sizeBytes   Int?
  encrypted   Boolean                @default(false)
  metadata    Json                   @default("{}")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  run         AutomationRun?          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId, runId, type])
}

model AutomationView {
  id                   String   @id @default(cuid())
  projectId            String
  scenarioId           String?
  actionId             String?
  name                 String   @default("")
  url                  String   @default("")
  title                String   @default("")
  screenshotArtifactId String?
  screenshotUri        String   @default("")
  viewport             Json     @default("{}")
  domSnapshot          Json     @default("{}")
  accessibilityTree    Json     @default("{}")
  elementSnapshots     Json     @default("[]")
  metadata             Json     @default("{}")
  capturedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  elements             AutomationElement[]

  @@index([projectId, capturedAt])
  @@index([projectId, scenarioId, capturedAt])
}

model AutomationElement {
  id                String   @id @default(cuid())
  projectId         String
  viewId            String?
  name              String
  elementType       String   @default("element")
  status            String   @default("active")
  canonicalLocator  Json     @default("{}")
  locatorCandidates Json     @default("[]")
  fallbackLocators  Json     @default("[]")
  boundingBox       Json     @default("{}")
  elementSnapshot   Json     @default("{}")
  lastVerifiedAt    DateTime?
  stabilityScore    Float    @default(0)
  preferredLocatorStrategy String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  view              AutomationView? @relation(fields: [viewId], references: [id], onDelete: SetNull)
  usages            AutomationElementUsage[]

  @@index([projectId, name])
  @@index([projectId, viewId])
}

model AutomationElementUsage {
  id          String   @id @default(cuid())
  projectId   String
  elementId   String
  scenarioId  String?
  actionId    String?
  stepId      String?
  usageType   String   @default("command")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element     AutomationElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([projectId, elementId])
  @@index([projectId, scenarioId])
  @@index([projectId, actionId])
}

model AutomationPlaybackJob {
  id             String   @id @default(cuid())
  projectId      String
  scenarioId     String?
  actionId       String?
  sessionId      String?
  status         String   @default("queued")
  scope          String   @default("fullScenario")
  configSnapshot Json     @default("{}")
  logs           Json     @default("[]")
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          AutomationPlaybackItem[]

  @@index([projectId, createdAt])
  @@index([projectId, status, updatedAt])
}

model AutomationPlaybackItem {
  id          String   @id @default(cuid())
  jobId       String
  stepId      String?
  orderIndex  Int
  status      String   @default("pending")
  command     Json     @default("{}")
  result      Json     @default("{}")
  logs        Json     @default("[]")
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         AutomationPlaybackJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, orderIndex])
  @@index([jobId, status])
}

model AutomationPlaybackConfig {
  id                   String   @id @default(cuid())
  projectId            String
  scenarioId           String?
  autoPlaybackEnabled  Boolean  @default(true)
  pauseOnElementErrors Boolean  @default(true)
  selfHealingEnabled   Boolean  @default(true)
  environmentId        String?
  autoElementTimeoutMs Int      @default(5000)
  manualElementTimeoutMs Int    @default(30000)
  manualPageTimeoutMs  Int      @default(60000)
  executionParameters  Json     @default("{}")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scenarioId])
  @@index([projectId])
}
